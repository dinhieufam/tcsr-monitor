# Copy to .env and fill in your values. Never commit .env.

# Dataset roots
ENDOVIS2017_ROOT=/data/endovis2017
CHOLECSEG8K_ROOT=/data/cholecseg8k

# Experiment output root (default: experiments/ in repo)
EXPERIMENT_ROOT=experiments

# Weights & Biases — set to "online" to enable, "disabled" to skip
WANDB_MODE=disabled
WANDB_PROJECT=tcsr-monitor
WANDB_ENTITY=

# CUDA determinism
CUBLAS_WORKSPACE_CONFIG=:4096:8

# Random seed default
SEED=42
